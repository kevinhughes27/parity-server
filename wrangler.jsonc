{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parity",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",

  // The React app. Unknown paths serve index.html; /api/* always runs the Worker.
  // (with the vite plugin the build output directory is set automatically)
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/submit_game"]
  },

  // One SQLite backed Durable Object per league (see worker/league.ts)
  "durable_objects": {
    "bindings": [{ "name": "LEAGUE", "class_name": "LeagueObject" }]
  },
  // Durable Object *class* migrations (creating/renaming classes), not the SQL schema.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LeagueObject"] }],

  // Daily Zuluru roster + schedule sync for the current league (UTC, 3am Toronto)
  "triggers": { "crons": ["0 8 * * *"] },

  // Set with `./dev wrangler secret put NAME`. Locally they come from .dev.vars
  "secrets": { "required": ["ADMIN_PASSWORD", "ZULURU_USER", "ZULURU_PASSWORD"] },

  "observability": { "enabled": true },

  // Uncomment once the Worker lives in the account that owns ocua.ca. Until then
  // it is served at https://parity.<account-subdomain>.workers.dev
  // "routes": [{ "pattern": "parity.ocua.ca", "custom_domain": true }],

  "env": {
    // A separate Worker with its own Durable Objects (so its own data).
    // Deploy with `./dev deploy --env staging`. Bindings are not inherited.
    "staging": {
      "durable_objects": {
        "bindings": [{ "name": "LEAGUE", "class_name": "LeagueObject" }]
      },
      "triggers": { "crons": [] }
    }
  }
}
